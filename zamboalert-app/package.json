{
  "name": "zamboalert-citizen",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "private": true,
  "scripts": {
    "start": "expo start --lan",
    "start:ip": "cross-env REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.17 expo start --lan",
