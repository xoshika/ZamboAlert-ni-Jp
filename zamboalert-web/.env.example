# Mapbox Access Token (Get this from https://account.mapbox.com/)
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Deployed Backend URL (Render Web Service)
# In production on Vercel, set this to your Render service URL (without trailing slash)
# Example: https://zamboalert-backend.onrender.com
VITE_API_BASE_URL=
VITE_TELEMETRY_URL=

# Local development fallback port (default: 5000)
# VITE_API_PORT=5000
